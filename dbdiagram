Table groups {
  id integer [primary key]
  uuid varchar [not null, unique]
  name varchar [not null,note:"グループ名"]
  outing_schedule timestamp [not null,note: "ご飯日程"]
  created_at timestamp
  updated_at timestamp
}

Table shops {
  id integer [primary key]
  name varchar [not null,note: "お店の名前"]
  address varchar [note: "お店の住所"]
  url varchar [note: "お店のURL"]
  status integer [not null,note: "0:候補、1:行き先決定"]
  lat float [note: "緯度"]
  lng float [note: "経度"]
  group_id integer [not null, ref: > groups.id]
  created_at timestamp
  updated_at timestamp
}

Table votes {
  id integer [primary key]
  group_id integer [not null, ref: > groups.id]
  shop_id integer [not null, ref: > shops.id]
  user_token varchar [not null, note: "ユーザーを一意に識別するID"]
  score integer [not null, note: "投票した得点"]
  created_at timestamp
  updated_at timestamp
}

Table questions {
  id integer [primary key]
  text varchar [not null,note: "質問内容"]
  input_type varchar [not null, note: "入力タイプ（例：text, multiple_choiceなど）"]
  options json [note: "選択肢（input_typeがmultiple_choiceの場合などに使用）"]
  is_default boolean [not null, default: false, note: "グループ共通の質問かどうか"]
  created_at timestamp
  updated_at timestamp
}

Table answers{
  id integer [primary key]
  question_id interger [not null,ref: > questions.id]
  group_id integer [not null,ref: > groups.id]
  user_token varchar [not null, note: "ユーザーを一意に識別するID"]
  content varchar [note: "ユーザーの回答"]
  created_at timestamp
  updated_at timestamp
}

Table user_schedules{
  id integer [primary key]
  group_schedule_date_id integer [not null,ref: > group_schedule_dates.id]
  choice integer [not null,note: "0:×、1:△、2:○"]
  schedule_participant_id integer [not null,ref: > schedule_participants.id]
  created_at timestamp
  updated_at timestamp
}

Table group_schedule_dates{
  id integer [primary key]
  date date [not null,note:"候補日"]
  group_id integer [not null,ref: > groups.id]
  created_at timestamp
  updated_at timestamp
}

Table schedule_participants{
  id integer [primary key]
  group_id integer [not null,ref: > groups.id]
  name varchar [not null,note:"ユーザー名"]
  created_at timestamp
  updated_at timestamp
}