<body class="bg-base-200 min-h-screen">
  <main class="container mx-auto px-4 py-6 max-w-md">
    <%= render 'shared/error_messages', object: @shop%>
    <!-- フォーム本体 -->
    <div class="card bg-base-100 shadow-md rounded-2xl">
      <div class="card-body px-6 py-8">
        <%= form_with model: @shop, url: group_shops_path(@group) do |f| %>
          <h2 class="text-3xl font-bold mb-8">候補登録</h2>

          <div
              data-controller="ogp-form"
              data-ogp-form-target="container"
            >
            <!-- ローディング（初期は非表示） -->
            <div
              data-ogp-form-target="loading"
              class="hidden absolute inset-0 bg-base-200/70 flex items-center justify-center z-50 rounded-2xl"
            >
              <span class="loading loading-spinner loading-lg text-primary"></span>
            </div>
            <!-- リンク -->
            <div class="mb-6">
              <label class="block text-xl font-bold mb-3">リンク</label>
              <%= f.text_field :url, 
                  id: "shop-url",
                  placeholder: "https://example.com", 
                  class: "input input-bordered w-full text-lg",
                  data: {
                    ogp_form_target: "url",
                  }
              %>
            </div>

            <!-- 店舗名 -->
            <div class="mb-6">
              <div class="block">
                <label class="text-xl font-bold mb-3">店舗名</label>
                <button 
                    type="button" 
                    class="btn btn-outline btn-xs ml-2 mb-2" 
                    data-action="click->ogp-form#fetchOgp"
                  >
                    リンクから店舗名を取得
                </button>
              </div>
              <%= f.text_field :name, 
                  id: "shop-name",
                  placeholder: "XXXXXXXXXXX", 
                  class: "input input-bordered w-full text-lg",
                  data: { ogp_form_target: "name" } %>
            </div>

            <!-- 場所 -->
            <div class="mb-8">
              <label class="block text-xl font-bold mb-3">場所</label>
              <%= f.text_field :address, 
                  id: "shop-address",
                  placeholder: "XXXXXXXXXXXX", 
                  class: "input input-bordered w-full text-lg",
                  data: { ogp_form_target: "address" } %>
            </div>
          </div>

          <!-- ボタン -->
          <div class="flex gap-4 justify-center">
            <%= link_to "戻る", group_path(@group), 
                class: "btn btn-neutral rounded-full px-12 text-xl" %>
            <%= f.submit "登録", 
                class: "btn btn-primary text-white rounded-full px-12 text-xl" %>
          </div>
        <% end %>
      </div>
    </div>
  </main>
</body>