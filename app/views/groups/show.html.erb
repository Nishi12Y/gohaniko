<!-- app/views/stores/index.html.erb -->
<body class="bg-base-200 min-h-screen">
  <!-- メインコンテンツ -->
  <main class="container mx-auto px-4 py-6 max-w-md" data-controller="change-view">
    <%= render "shared/flash_message" %>
    <!-- フラッシュメッセージ -->
    <div id="flash-message" class="hidden fixed top-0 left-0 right-0 z-50">
      <div class="alert shadow-lg">
        <svg xmlns="http://www.w3.org/2000/svg" class="stroke-current flex-shrink-0 h-6 w-6" fill="none" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
        <span>URLをコピーしました！</span>
      </div>
    </div>
    <!-- タイトルセクション -->
    <div class="mb-6">
      <div class="flex items-center gap-2 mb-2">
        <h2 class="text-3xl font-bold"><%=@group.name %></h2>
      </div>
      <div data-controller="copy" data-copy-url-value="https://gohaniko.onrender.com/groups/<%= @group.uuid %>">
        <button 
          id="copyButton"
          class="btn btn-outline btn-xs mb-5"
          data-action="click->copy#copy"
          title="コピーボタン"
        >
          グループリンクをコピー
        </button>
      </div>
      <div class="grid grid-cols-2 gap-3 mb-4">
        <a href="<%= new_group_shop_path(@group) %>" class="btn btn-primary text-white">候補登録</a>
        <a href="<%= group_group_schedule_dates_path(@group) %>" class="btn btn-neutral">スケジュール調整</a>
      </div>
      <div class="grid grid-cols-2 gap-3">
        <a href="<%= group_answers_path(@group) %>" class="btn btn-neutral">みんなの意見</a>
        <a href="<%= group_votes_path(@group) %>" class="btn btn-primary text-white">投票結果</a>
      </div>
    </div>

    <!-- 切り替えタブ -->
    <div class="relative flex justify-center gap-8 mb-4 border-b-2" style="border-color: #F8BE66">
      <button 
        class="pb-2 font-bold text-lg relative z-10"
        data-change-view-target="listTab"
        data-action="click->change-view#showList"
      >
        候補一覧
      </button>
      <button 
        class="pb-2 font-bold text-lg relative z-10"
        data-change-view-target="mapTab"
        data-action="click->change-view#showMap"
      >
        マップ
      </button>
      <!-- スライドする下線 -->
      <div 
        class="absolute bottom-0 h-1 transition-all duration-300 ease-in-out"
        style="background-color: #F8BE66"
        data-change-view-target="indicator"
      ></div>
    </div>

    <!-- 候補一覧 -->
    <div data-change-view-target="listView">
      <% @shops.each do |shop| %>
        <%= render partial: "shops/shop_card", locals: { shop: shop, delete_button: true, vote: true } %>
      <% end %>
    </div>

    <!-- マップビュー -->
    <div class="hidden" data-change-view-target="mapView">
      <%= render partial: "map", locals: { shops: @shops, map_shops: @map_shops, map_api_key: @map_api_key } %>
    </div>
  </main>
</body>
</html>
