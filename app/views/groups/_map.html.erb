<div
    data-controller="google-map"
    data-google-map-shops-value="<%= map_shops.to_json %>"
    data-google-map-api-key-value="<%= map_api_key %>"
>
    <div
        data-google-map-target="canvas"
        class="w-full h-96 rounded-2xl overflow-hidden shadow bg-white"
    ></div>
    <!-- Shops Table -->
    <div class="overflow-x-auto bg-base-100 rounded-2xl shadow">
        <table class="table table-zebra w-full">
        <thead>
            <tr>
            <th>店名</th>
            <th>マップ</th>
            </tr>
        </thead>

        <tbody>
            <% shops.each do |shop| %>
            <tr id="shop-<%= shop.id %>">
                <!-- 店名 -->
                <td class="font-semibold">
                <%= shop.name %>
                </td>

                <!-- 座標 -->
                <td>
                <% if shop.lat.present? && shop.lng.present? %>
                    <%= link_to "マップで表示", "#",
                    class: "link link-primary",
                    data: {
                        action: "click->google-map#focus",
                        google_map_id_param: shop.id,
                        turbo: false
                    } %>
                <% else %>
                    <span class="badge badge-ghost">なし</span>
                <% end %>
                </td>
            </tr>
            <% end %>

            <% if @shops.blank? %>
            <tr>
                <td colspan="5" class="text-center opacity-60 py-8">
                候補がまだ登録されていません
                </td>
            </tr>
            <% end %>
        </tbody>
        </table>
    </div>
</div>