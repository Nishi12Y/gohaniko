<% input_name = "answers[#{question.id}]" %>
<div class="<%= container_class %>">
  <label class="block text-sm font-medium mb-2">
    <%= question.text %>
  </label>
  <% case question.input_type %>
  <% when "select" %>
    <%
      select_options = (question.options || []).map do |option|
        data = option.respond_to?(:with_indifferent_access) ? option.with_indifferent_access : option
        [data[:label], data[:value]]
      end
    %>
    <%= select_tag input_name,
        options_for_select(select_options,answer),
        class: "select select-bordered w-full bg-white" %>
  <% when "time" %>
    <%= time_field_tag input_name,
        answer,
        class: "input input-bordered w-full bg-white" %>
  <% else %>
    <%= text_field_tag input_name,
        answer,
        placeholder: "自由にご記入ください",
        class: "input input-bordered w-full bg-white" %>
  <% end %>
</div>