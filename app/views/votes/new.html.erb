<div class="min-h-screen bg-amber-50 p-4">
  <div class="max-w-md mx-auto">
    
    <!-- Title and Top Button -->
    <div class="flex items-center justify-between mb-6">
      <h1 class="text-xl font-bold">投票画面</h1>
      <button class="btn btn-sm bg-stone-400 hover:bg-stone-500 text-white rounded-full">
        トップページへ
      </button>
    </div>

    <%= form_with url: "#", method: :post, local: true do |f| %>
      <% @shops.each do |shop| %>
          <%= render partial: "vote_card", locals: { shop: shop, f: f } %>
      <% end %>
      <!-- Submit Button -->
      <div class="flex justify-center">
        <%= f.submit "送信", class: "btn btn-wide btn-primary rounded-full text-lg" %>
      </div>
    <% end %>
  </div>
</div>
