<div class="min-h-screen bg-[#FFF8E7] flex items-center justify-center px-6 py-8">
    <div class="w-full max-w-md">
    <%= form_with url: group_user_schedules_path(@group), method: :post, local: true do |f| %>
      <!-- 日付と投票セクション -->
      <div class="mb-8">
        <p class="text-gray-700 mb-6 font-medium">出欠を入力してください</p>
        
        <div class="space-y-4">
          <% @group_schedule_dates.each_with_index do |date, index| %>
            <div class="flex items-center gap-4">
              <!-- 日付表示 -->
              <div class="w-16 text-gray-700 font-medium">
                <%= date.date.strftime('%-m/%-d') %>
              </div>
              <!-- 日付ID -->
            　<%= hidden_field_tag "schedules[#{index}][group_schedule_date_id]", date.id %>
              
              <!-- 投票ボタン -->
              <div class="flex gap-3">
                <!-- ○ボタン -->
                <label class="cursor-pointer">
                  <%= f.radio_button "schedules[#{index}][choice]", 2, class: "hidden peer", id: "good_#{index}"%>
                  <div class="w-10 h-10 rounded-full border-2 border-[#F5C869] flex items-center justify-center peer-checked:bg-[#F5C869]/70 peer-checked:border-[#F5C869] hover:bg-[#F5C869]/20 transition-colors">
                    <span class="text-[#F5C869] text-xl font-bold">○</span>
                  </div>
                </label>

                <!-- △ボタン -->
                <label class="cursor-pointer">
                  <%= f.radio_button "schedules[#{index}][choice]", 1, class: "hidden peer", id: "maybe_#{index}" %>
                  <div class="w-10 h-10 rounded-full border-2 border-[#F5C869] flex items-center justify-center peer-checked:bg-[#F5C869]/70 peer-checked:border-[#F5C869] hover:bg-[#F5C869]/20 transition-colors">
                    <span class="text-[#F5C869] text-xl font-bold">△</span>
                  </div>
                </label>

                <!-- ×ボタン -->
                <label class="cursor-pointer">
                  <%= f.radio_button "schedules[#{index}][choice]", 0, class: "hidden peer", id: "bad_#{index}" %>
                  <div class="w-10 h-10 rounded-full border-2 border-[#F5C869] flex items-center justify-center peer-checked:bg-[#F5C869]/70 peer-checked:border-[#F5C869] hover:bg-[#F5C869]/20 transition-colors">
                    <span class="text-[#F5C869] text-xl font-bold">×</span>
                  </div>
                </label>
              </div>
            </div>
          <% end %>
        </div>
      </div>

      <!-- 名前入力セクション -->
      <div class="mb-8">
        <label for="name" class="block text-gray-700 mb-3 font-medium">名前</label>
        <%= f.text_field "schedule_participant[name]", 
            placeholder: "", 
            class: "w-full px-4 py-3 rounded-lg border-0 bg-white shadow-sm focus:ring-2 focus:ring-[#F5C869] focus:outline-none",
            id: "name" %>
      </div>

      <!-- 送信ボタン -->
      <div class="flex justify-center">
        <%= f.submit "選択した内容で回答する", 
            class: "bg-[#E8A5A5] text-white px-8 py-4 rounded-lg font-medium hover:bg-[#E09090] transition-colors cursor-pointer shadow-sm w-full max-w-xs" %>
      </div>
    <% end %>
    </div>
  </div>
</div>